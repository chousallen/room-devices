#!/bin/bash
# Mirror the laptop screen on the room monitor.  pi-screen start | stop | status
case "${1:-}" in
  start)  sudo systemctl start moonlight-stream.service ;;
  stop)   sudo systemctl stop moonlight-stream.service ;;
  restart) sudo systemctl stop moonlight-stream.service; sleep 1; sudo systemctl start moonlight-stream.service ;;
  status) systemctl is-active moonlight-stream.service pi-dashboard.service | paste -sd' ' | sed 's/^/stream dashboard: /' ;;
  *) echo "usage: pi-screen start|stop|restart|status" >&2; exit 2 ;;
esac
