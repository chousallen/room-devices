# One-shot media player on the monitor; started by `pi-play`. Stops Moonlight while it runs.
[Unit]
Description=Room media player (GStreamer, hardware decode)
Conflicts=moonlight.service getty@tty7.service
After=user@1000.service

[Service]
Type=simple
User=sallen
Group=sallen
SupplementaryGroups=video render audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=/run/pi-player/env
ExecStart=/usr/local/bin/pi-player-run
# When playback ends, hand the screen back to Moonlight.
ExecStopPost=/bin/systemctl --no-block start moonlight.service
