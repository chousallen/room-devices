# One-shot media player on the monitor; started by `pi-play`. Stops the dashboard/Moonlight while it runs.
[Unit]
Description=Room media player (GStreamer, hardware decode)
Conflicts=pi-dashboard.service moonlight.service getty@tty1.service
# After= the idle-screen units too, or the player opens /dev/dri while one still holds DRM master.
After=user@1000.service pi-dashboard.service moonlight.service

[Service]
Type=simple
User=sallen
Group=sallen
SupplementaryGroups=video render audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=/run/pi-player/env
ExecStart=/usr/local/bin/pi-player-run
# When playback ends, hand the screen back to the dashboard.
ExecStopPost=+/bin/systemctl --no-block start pi-dashboard.service
