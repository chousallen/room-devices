# Ctrl+Alt+Fx on the Pi's own keyboard: switch between the dashboard / stream and a text console
# (see pi/bin/pi-console-keys). Moonlight (patch 0007) never forwards the combo to the laptop.
[Unit]
Description=Ctrl+Alt+Fx handling for the Pi keyboard (menu <-> console)
After=systemd-udevd.service

[Service]
ExecStart=/usr/local/bin/pi-console-keys
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
