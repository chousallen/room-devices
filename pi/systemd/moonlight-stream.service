# Moonlight (game-streaming receiver) full-screen on the HDMI monitor, no desktop needed.
# Runs as the audio user so its sound goes into that user's PipeWire (mixed with everything else).
# XDG_RUNTIME_DIR is required or Moonlight has no audio (moonlight-qt issue #804).
[Unit]
Description=Moonlight: stream the laptop desktop to the monitor
# Conflicts= alone gives no ordering: the stream and the menu stop ran in parallel and the stream
# opened /dev/dri while the menu still held DRM master (errno 13 everywhere, no picture). After= on
# the conflicting units makes systemd finish stopping them before this unit starts.
After=user@1000.service systemd-user-sessions.service moonlight.service pi-player.service
Wants=user@1000.service
Conflicts=getty@tty2.service pi-player.service moonlight.service

[Service]
# the Pi is shared with other services; keep the decoder/pacer threads ahead of them
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
User=sallen
Group=sallen
SupplementaryGroups=video render input audio
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
# Video only: Moonlight decodes the stream audio into SDL's dummy backend, so it never reaches the mixer.
# Sunshine's audio path stuttered on the Pi (audio packet queue overflow every few minutes under
# the decode CPU load) and doubled the RTP path; laptop sound goes over "Room speaker (Pi)" instead.
# --audio-on-host keeps Sunshine from switching the laptop's default output to sink-sunshine-stereo.
Environment=SDL_AUDIODRIVER=dummy
# local build (build/patches/0003): log received/decoded/rendered/dropped frame counts every 5 s
Environment=MOONLIGHT_STATS_INTERVAL=5
# Foreground VT = tty2, where SDL puts the keyboard in K_OFF: the kernel ignores Ctrl+Alt+Fx and only Moonlight
# sees it (forwarded to the laptop); keys typed here no longer reach the Pi's login prompts.
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/usr/local/bin/moonlight-qt stream 192.168.0.193 Desktop --resolution 1920x1080 --fps 60 --bitrate 50000 --vsync --frame-pacing --audio-on-host
# when the stream ends (or is stopped), bring the Moonlight menu back
ExecStopPost=+/usr/bin/kbd_mode -u -C /dev/tty2
ExecStopPost=+/bin/systemctl --no-block start moonlight.service
Restart=no
# moonlight-qt ignores SIGTERM while streaming; do not make pi-screen stop wait 90 s
TimeoutStopSec=5
KillMode=mixed
RestartSec=3

