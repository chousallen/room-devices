# Moonlight (game-streaming receiver) full-screen on the HDMI monitor, no desktop needed.
# Runs as the audio user so its sound goes into that user's PipeWire (mixed with everything else).
# XDG_RUNTIME_DIR is required or Moonlight has no audio (moonlight-qt issue #804).
[Unit]
Description=Moonlight: stream the laptop desktop to the monitor
After=user@1000.service systemd-user-sessions.service
Wants=user@1000.service
Conflicts=getty@tty8.service pi-player.service moonlight.service

[Service]
# the Pi is shared with other services; keep the decoder/pacer threads ahead of them
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
User=sallen
Group=sallen
SupplementaryGroups=video render input audio
PAMName=login
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=SDL_AUDIODRIVER=pulseaudio
ExecStart=/usr/bin/moonlight-qt stream 192.168.0.193 Desktop --resolution 1920x1080 --fps 60 --bitrate 20000 --vsync --no-frame-pacing --audio-on-host
# when the stream ends (or is stopped), bring the Moonlight menu back
ExecStopPost=+/bin/systemctl --no-block start moonlight.service
Restart=no
# moonlight-qt ignores SIGTERM while streaming; do not make pi-screen stop wait 90 s
TimeoutStopSec=5
KillMode=mixed
RestartSec=3

