#!/bin/bash
# Keep the Pi's speaker available as the output device "Room-speaker-Pi" (sink pi_speaker).
# PipeWire's pulse-tunnel module does not retry if the Pi is unreachable when it loads and
# unloads itself when the Pi reboots, so a timer runs this every 20 s and (re)creates it.
PI=${PI_HOST_IP:-192.168.0.101}
LAT=${PI_SPEAKER_LATENCY_MS:-400}  # end-to-end target. Measured: 80 -> constant gaps, 200 -> 11 underflows/2 min, 300 -> 2, 400 -> 0
pactl list sinks short 2>/dev/null | grep -q $'\tpi_speaker\t' && exit 0
nc -z -w2 "$PI" 4713 2>/dev/null || exit 0
pactl load-module module-tunnel-sink "server=tcp:$PI:4713" sink_name=pi_speaker "latency_msec=$LAT" \
  sink_properties=device.description=Room-speaker-Pi >/dev/null && echo "pi_speaker sink created (latency ${LAT} ms)"
