Subject: Keep Ctrl+Alt+Fx on the Pi and quiet drmModeSetPlane while on another VT

On the Pi, pi-console-keys switches VTs with Ctrl+Alt+F1..F12 while the
stream keeps running: SDL 2.32 puts the stream's tty in VT_PROCESS mode
and drops / re-takes DRM master on VT leave / return. Do not forward the
combo to the host, and log the resulting EACCES from drmModeSetPlane()
once per run of failures instead of once per frame.

diff --git a/app/streaming/input/keyboard.cpp b/app/streaming/input/keyboard.cpp
index 4ee8ed2..b51b6ee 100644
--- a/app/streaming/input/keyboard.cpp
+++ b/app/streaming/input/keyboard.cpp
@@ -155,6 +155,15 @@ void SdlInputHandler::handleKeyEvent(SDL_KeyboardEvent* event)
         return;
     }
 
+    // Ctrl+Alt+F1..F12 belongs to the Pi: pi-console-keys switches the Pi's VT with it
+    // (SDL keeps the stream running in the background), so never send it to the host.
+    if ((event->keysym.mod & KMOD_CTRL) &&
+            (event->keysym.mod & KMOD_ALT) &&
+            event->keysym.scancode >= SDL_SCANCODE_F1 &&
+            event->keysym.scancode <= SDL_SCANCODE_F12) {
+        return;
+    }
+
     // Check for our special key combos
     if ((event->state == SDL_PRESSED) &&
             (event->keysym.mod & KMOD_CTRL) &&
diff --git a/app/streaming/video/ffmpeg-renderers/drm.cpp b/app/streaming/video/ffmpeg-renderers/drm.cpp
index b539c19..1b47c00 100644
--- a/app/streaming/video/ffmpeg-renderers/drm.cpp
+++ b/app/streaming/video/ffmpeg-renderers/drm.cpp
@@ -157,6 +157,7 @@ DrmRenderer::DrmRenderer(AVHWDeviceType hwDeviceType, IFFmpegRenderer *backendRe
       m_CrtcId(0),
       m_PlaneId(0),
       m_CurrentFbId(0),
+      m_SetPlaneFailing(false),
       m_LastFullRange(false),
       m_LastColorSpace(-1),
       m_Plane(nullptr),
@@ -1354,13 +1355,22 @@ void DrmRenderer::renderFrame(AVFrame* frame)
                           frame->width << 16,
                           frame->height << 16);
     if (err < 0) {
-        SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
-                     "drmModeSetPlane() failed: %d",
-                     errno);
+        // While another VT is in front SDL has dropped DRM master and every frame fails
+        // with EACCES; log only the first failure of a run instead of 60 lines per second.
+        if (!m_SetPlaneFailing) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                         "drmModeSetPlane() failed: %d (further failures not logged until it works again)",
+                         errno);
+            m_SetPlaneFailing = true;
+        }
         drmModeRmFB(m_DrmFd, m_CurrentFbId);
         m_CurrentFbId = lastFbId;
         return;
     }
+    if (m_SetPlaneFailing) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "drmModeSetPlane() works again");
+        m_SetPlaneFailing = false;
+    }
 
     // Free the previous FB object which has now been superseded
     drmModeRmFB(m_DrmFd, lastFbId);
