+// On the Pi the stream runs on its own Linux VT (systemd TTYPath=/dev/tty2 on stdin) and
+// pi-console-keys switches to a text console with Ctrl+Alt+Fx while the stream keeps
+// running in the background. SDL keeps reading the evdev devices while our VT is away,
+// so the session forwards input to the host only while our VT is the foreground one.
+// Without a VT on stdin (desktop builds, the menu) this always returns true.
+bool SdlInputHandler::isOwnVtInFront()
+{
+#ifdef Q_OS_LINUX
+    static int ownVt = -2;      // -2 = not probed yet, -1 = stdin is not a VT
+    static bool blocked = false;
+
+    if (ownVt == -2) {
+        struct stat st;
+        ownVt = -1;
+        if (fstat(STDIN_FILENO, &st) == 0 && S_ISCHR(st.st_mode) &&
+                major(st.st_rdev) == 4 && minor(st.st_rdev) >= 1 && minor(st.st_rdev) <= 63) {
+            ownVt = minor(st.st_rdev);
+        }
+        if (ownVt > 0) {
+            SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                        "Stdin is VT %d: input goes to the host only while it is in front",
+                        ownVt);
+        }
+        else {
+            SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                        "Stdin is not a VT: input to the host is not gated on the foreground VT");
+        }
+    }
+    if (ownVt < 0) {
+        return true;
+    }
+
+    struct vt_stat vts;
+    if (ioctl(STDIN_FILENO, VT_GETSTATE, &vts) != 0) {
+        return true;
+    }
+
+    bool inFront = vts.v_active == ownVt;
+    if (!inFront && !blocked) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                    "VT %d in front: input to the host blocked", vts.v_active);
+        blocked = true;
+    }
+    else if (inFront && blocked) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                    "VT %d back in front: input to the host resumed", ownVt);
+        blocked = false;
+    }
+    return inFront;
+#else
+    return true;
+#endif
+}
